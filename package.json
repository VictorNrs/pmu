{
  "name": "pmu-stallion-stats",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Analyse statistique des performances des étalons en courses hippiques",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace @pmu/api",
    "db:deploy": "npm run db:deploy --workspace @pmu/api",
    "dev:api": "npm run dev --workspace @pmu/api",
    "dev:web": "npm run dev --workspace @pmu/web",
    "build": "npm run build --workspace @pmu/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.10.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
