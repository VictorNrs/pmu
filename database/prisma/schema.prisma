// Source data only: every statistic is computed from `participations`.
// CHECK constraints that Prisma cannot express are added in the migrations.

generator client {
  provider     = "prisma-client"
  output       = "../../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Stallion {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(120)
  /// Normalized name (lowercase, no accents) used to prevent duplicates.
  nameKey   String   @unique @map("name_key") @db.VarChar(120)
  birthYear Int?     @map("birth_year") @db.SmallInt
  country   String?  @db.VarChar(60)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  horses    Horse[]

  @@map("stallions")
}

model Horse {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar(120)
  nameKey        String          @unique @map("name_key") @db.VarChar(120)
  stallionId     Int             @map("stallion_id")
  stallion       Stallion        @relation(fields: [stallionId], references: [id], onDelete: Restrict)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  participations Participation[]

  @@index([stallionId])
  @@map("horses")
}

model TerrainCondition {
  id        Int     @id @default(autoincrement())
  label     String  @db.VarChar(60)
  labelKey  String  @unique @map("label_key") @db.VarChar(60)
  sortOrder Int     @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")
  races     Race[]

  @@map("terrain_conditions")
}

model Racecourse {
  id      Int    @id @default(autoincrement())
  name    String @db.VarChar(120)
  nameKey String @unique @map("name_key") @db.VarChar(120)
  races   Race[]

  @@map("racecourses")
}

model Race {
  id                 Int              @id @default(autoincrement())
  raceDate           DateTime         @map("race_date") @db.Date
  racecourseId       Int              @map("racecourse_id")
  racecourse         Racecourse       @relation(fields: [racecourseId], references: [id], onDelete: Restrict)
  distanceMeters     Int              @map("distance_meters")
  terrainConditionId Int              @map("terrain_condition_id")
  terrainCondition   TerrainCondition @relation(fields: [terrainConditionId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  participations     Participation[]

  /// Target of the composite foreign key from participations (see Participation.raceDate).
  @@unique([id, raceDate])
  @@index([raceDate])
  @@index([racecourseId])
  @@index([terrainConditionId])
  @@index([distanceMeters])
  @@map("races")
}

model Participation {
  id             Int      @id @default(autoincrement())
  raceId         Int      @map("race_id")
  /// Copy of races.race_date kept in sync by the composite foreign key (ON UPDATE CASCADE).
  /// It lets PostgreSQL guarantee that a horse runs at most one race per day.
  raceDate       DateTime @map("race_date") @db.Date
  race           Race     @relation(fields: [raceId, raceDate], references: [id, raceDate], onDelete: Cascade, onUpdate: Cascade)
  horseId        Int      @map("horse_id")
  horse          Horse    @relation(fields: [horseId], references: [id], onDelete: Restrict)
  finishPosition Int      @map("finish_position") @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([raceId, horseId])
  @@unique([horseId, raceDate])
  @@map("participations")
}
